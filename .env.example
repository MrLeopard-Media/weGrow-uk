# Central API Base URL for WeGrow Skill Campus
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Optional public contact details for requests to .uk domains.
# Enter phone numbers in international format, including +44.
# Separate multiple phone numbers with a comma.
UK_CONTACT_EMAIL=
UK_CONTACT_PHONE=
UK_CONTACT_WHATSAPP=
UK_CONTACT_ADDRESS=
UK_CONTACT_HOURS=

# ImageKit CDN Configuration (Optional: paste your endpoint here to load images from ImageKit CDN)
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key

# ImageKit CDN Configuration (Optional: paste your endpoint here to load images from ImageKit CDN)
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key

